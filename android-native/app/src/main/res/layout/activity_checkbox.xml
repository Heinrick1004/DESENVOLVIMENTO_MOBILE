<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/color_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/checkbox_question"
            android:textColor="@color/color_primary_dark"
            android:textSize="22sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/checkbox_java"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/checkbox_java" />
        <CheckBox
            android:id="@+id/checkbox_kotlin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/checkbox_kotlin" />
        <CheckBox
            android:id="@+id/checkbox_flutter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/checkbox_flutter" />
        <CheckBox
            android:id="@+id/checkbox_python"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/checkbox_python" />

        <Button
            android:id="@+id/checkbox_verify"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="@string/checkbox_verify" />

        <TextView
            android:id="@+id/checkbox_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/color_text"
            android:textSize="17sp" />
    </LinearLayout>
</ScrollView>
